# Example environment configuration for local development

# App settings
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradescheme?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Security placeholders
JWT_SECRET="change-me-in-production"
SESSION_SECRET="change-me-in-production"

# Deriv broker integration
# Use your App ID and auth token from the Deriv developer portal.
DERIV_APP_ID="1"
DERIV_SERVER_URL="wss://ws.deriv.com/websockets/v3"
DERIV_API_TOKEN="replace_with_your_deriv_auth_token"

# Optional OAuth-based app flow
# DERIV_CLIENT_ID="your-deriv-client-id"
# DERIV_CLIENT_SECRET="your-deriv-client-secret"
# DERIV_REDIRECT_URI="http://localhost:3000/callback/deriv"
